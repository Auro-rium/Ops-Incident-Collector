# OpsIncident Collector production environment.
# Store real values in AWS Secrets Manager or your secret manager, not in this file.

INCIDENTOPS_API_URL=https://incidentops-core.internal.example.com
INCIDENTOPS_TOKEN=replace-with-secret-manager-value
PROJECT_ID=proj_REPLACE_ME
SOURCE_NAME=aws-demo-source
SOURCE_TYPE=filesystem
COLLECTOR_ENVIRONMENT=aws-prod
COLLECTOR_CONFIG=/app/examples/aws-daemon.yaml

# Optional aliases supported by local CLI usage.
INCIDENTOPS_PROJECT_ID=proj_REPLACE_ME
INCIDENTOPS_EDGE_STATE=/var/lib/opsincident-collector/state.sqlite
